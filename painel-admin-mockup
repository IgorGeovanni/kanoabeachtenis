  const subtotal = items.reduce((s, it) => s + it.qtd * it.preco, 0);
  const serviceValue = serviceOn ? subtotal * 0.1 : 0;
  const couvertTotal = couvertOn ? pessoas * couvertValue : 0;
  const total = subtotal + serviceValue + couvertTotal;

